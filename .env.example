# ========================================================
# ShadowTrace - Root Environment Configuration Template
# Copy this file to backend/.env and frontend/.env or
# configure each component individually.
# ========================================================

# --------------------------------------------------------
# Backend API Configuration (backend/.env)
# --------------------------------------------------------
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/shadowtrace
GEOLOCATION_API_URL=http://ip-api.com/json
GEOLOCATION_API_KEY=
JAVA_SERVICE_URL=http://127.0.0.1:8080
CLIENT_ORIGIN=http://localhost:5174
NODE_ENV=development

# Authentication & Admin Setup
JWT_SECRET=your_jwt_secret_key_change_in_production
ADMIN_EMAIL=admin@shadowtrace.local
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
ADMIN_NAME=System Administrator

# Email Provider Configuration
# EMAIL_PROVIDER can be 'resend' or 'smtp'. Defaults to 'resend' when RESEND_API_KEY is present.
EMAIL_PROVIDER=resend

# 1. Resend HTTPS API (Recommended for Render & cloud hosting — Port 443 HTTPS, bypasses SMTP blocks)
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Sender address: Use 'ShadowTrace <onboarding@resend.dev>' or your verified domain
RESEND_FROM_EMAIL=ShadowTrace <onboarding@resend.dev>

# 2. Nodemailer / Gmail SMTP Delivery (Optional for local development or unblocked SMTP networks)
# Note: Free-tier cloud hosts such as Render Free block outbound traffic on SMTP ports 25, 465, and 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM_EMAIL=ShadowTrace <your-sender@gmail.com>

# --------------------------------------------------------
# Frontend Configuration (frontend/.env)
# --------------------------------------------------------
# Production Vercel: Set to your Render backend URL (e.g. https://shadowtrace-backend-09sa.onrender.com)
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api
VITE_BACKEND_URL=http://localhost:5000/api
